# --- PostgreSQL ---
POSTGRES_DB=mydb
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpassword

# --- PgAdmin4 ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=adminpassword

# --- Ports externes ---
WEB_PP_PORT=8082
POSTGRES_PORT=5432
PGADMIN_PORT=8083